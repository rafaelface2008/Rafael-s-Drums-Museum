<%- include('../cabecalho')%>

    <div>
        <tr><a href="/prato"> ← Voltar </a></tr>
        <h3>Novo Prato</h3>

        <form method="post">
            <p>ID</p>
            <input type="text" name="id" value="<%=prato.id%>">
            <p>Marca</p>
            <input name="marca" type="text" placeholder="marca">
            <p>Série</p>
            <input name="serie" type="text" placeholder="serie">
            <br>
            <p>Liga</p>
            <input name="liga" type="text" placeholder="liga">
            <br>
            <p>tipo</p>
            <input name="tipo" type="text" placeholder="tipo do prato">
            <br>
            <p>Preço</p>
            <input type="number" value="0" name="preco" step="0.01" min="0" placeholder="0.00">
            <br>
            <p>Descrição</p>
            <textarea placeholder="Descrição do Prato..." name="descricao"></textarea>
            <br><br>

            <button type="submit">Adicionar</button>
            <button type="reset">Cancelar</button>

        </form>

    </div>
    </body>

    </html>